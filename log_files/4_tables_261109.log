. * Winsorize the six continuous model variables on the main estimation sample.
. foreach var in employment_gap lag_socx_ecec lag_fatherweeks10 lag_lngdp lag_gdp_growth leave_gdp {
  2.     summarize `var', detail
  3.     local low = r(p1)
  4.     local high = r(p99)
  5.     generate w_`var' = `var'
  6.     recast double w_`var'
  7.     replace w_`var' = `var'
  8.     replace w_`var' = `low' if `var'<`low'
  9.     replace w_`var' = `high' if `var'>`high'
 10. }

