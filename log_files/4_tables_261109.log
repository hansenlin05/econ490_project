. * winsorize the six continuous variables on the main sample
. foreach var in ln_gap ln_spending ln_leaveweeks lag_lngdp lag_gdp_growth ln_leavespending {
  2.     quietly summarize `var', detail
  3.     local low = r(p1)
  4.     local high = r(p99)
  5.     generate w_`var' = `var'
  6.     replace w_`var' = `low' if `var'<`low'
  7.     replace w_`var' = `high' if `var'>`high'
  8. }
